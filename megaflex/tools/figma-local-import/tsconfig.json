{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@figma/plugin-typings"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
